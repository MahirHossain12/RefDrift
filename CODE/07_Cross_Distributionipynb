, len(b))) for _ in range(n_boot)]\n","    return auc_np(neg, a) - auc_np(neg, b), float(np.percentile(ds, 2.5)), float(np.percentile(ds, 97.5))\n","W = json.load(open(f\"{XD}/window_cross.json\")); kappa = json.load(open(f\"{XD}/kappa_cross.json\"))[\"kappa_cross\"]\n","KS = sorted(int(k) for k in W)\n","print(f\"norm-matching factor for the cross-distribution attacker: {kappa:.3f}\")\n","AUC = {}\n","for key, label, sign in [(\"std\", \"STANDARD scoring\", -1), (\"ref\", \"REFERENCE-model scoring\", -1), (\"norm\", \"WEIGHT-UPDATE NORM\", +1)]:\n","    print(f\"\\n{label}: AUC [95% bootstrap CI], n=10 per group\")\n","    for title, pos in [(\"benign vs in-distribution malicious (AdvBench)\", \"mal_in\"), (\"benign vs CROSS-distribution malicious (JBB)\", \"mal_cross\"),\n","                       (\"benign vs cross-distribution, norm-matched\", \"mal_cross_matched\")]:\n","        cells = []\n","        for k in KS:\n","            a, lo, hi = auc_ci(W[str(k)][\"benign\"][key], W[str(k)][pos][key], sign); AUC[(key, pos, k)] = a; cells.append(f\"k={k}: {a:.2f} [{lo:.2f},{hi:.2f}]\")\n","        print(f\"  {title:48s} \" + \"  \".join(cells))\n","print(\"\\nPAIRED DIFFERENCE, in-distribution minus cross-distribution AUC (same benign clients), reference scoring:\")\n","dif = []\n","for k in KS:\n","    d, lo, hi = diff_ci(W[str(k)][\"benign\"][\"ref\"], W[str(k)][\"mal_in\"][\"ref\"], W[str(k)][\"mal_cross\"][\"ref\"], -1); dif.append(d)\n","    print(f\"  k={k}: {d:+.2f} [{lo:+.2f}, {hi:+.2f}]\")\n","x1 = float(np.mean([AUC[(\"ref\", \"mal_cross\", k)] for k in KS])); x2 = float(np.mean(dif))\n","print(\"\\nPRE-DECLARED CRITERIA (fixed before the run; reported whatever the outcome)\")\n","print(f\"  X1 mean reference-scoring AUC, benign vs cross-distribution malicious, over k=0,3,6,9 >= 0.85 : {x1:.3f} -> {'MET' if x1 >= 0.85 else 'NOT MET'}\")\n","print(f\"  X2 mean (in-distribution minus cross-distribution) AUC <= 0.10                                  : {x2:+.3f} -> {'MET' if x2 <= 0.10 else 'NOT MET'}\")\n","xm = float(np.mean([AUC[(\"ref\", \"mal_cross_matched\", k)] for k in KS if k > 0]))\n","print(f\"  X3 (report only) mean reference-scoring AUC vs the norm-matched cross-distribution attacker, k=3,6,9: {xm:.3f}\")\n","json.dump({\"X1\": x1, \"X2\": x2, \"X3\": xm, \"kappa_cross\": kappa, \"auc\": {f\"{a}|{b}|{c}\": v for (a, b, c), v in AUC.items()}}, open(f\"{XD}/analysis_detector.json\", \"w\"), indent=2)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"R6tOtmXU4nRl","executionInfo":{"status":"ok","timestamp":1793969832640,"user_tz":-360,"elapsed":9331,"user":{"displayName":"Mahir","userId":"10169784916887599401"}},"outputId":"60f86907-2fd3-479d-cd44-a8fe345784a1"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["CELL C4 (offline): detector under a cross-distribution attacker -- AUC tables and the criteria fixed in advance\n","norm-matching factor for the cross-distribution attacker: 0.797\n","\n","STANDARD scoring: AUC [95% bootstrap CI], n=10 per group\n","  benign vs in-distribution malicious (AdvBench)   k=0: 1.00 [1.00,1.00]  k=3: 0.82 [0.59,0.99]  k=6: 0.43 [0.14,0.72]  k=9: 0.23 [0.04,0.46]\n","  benign vs CROSS-distribution malicious (JBB)     k=0: 0.98 [0.91,1.00]  k=3: 0.48 [0.21,0.75]  k=6: 0.24 [0.03,0.49]  k=9: 0.02 [0.00,0.09]\n","  benign vs cross-distribution, norm-matched       k=0: 0.99 [0.94,1.00]  k=3: 0.42 [0.18,0.70]  k=6: 0.11 [0.00,0.28]  k=9: 0.04 [0.00,0.14]\n","\n","REFERENCE-model scoring: AUC [95% bootstrap CI], n=10 per group\n","  benign vs in-distribution malicious (AdvBench)   k=0: 1.00 [1.00,1.00]  k=3: 0.91 [0.74,1.00]  k=6: 0.62 [0.34,0.86]  k=9: 0.65 [0.40,0.88]\n","  benign vs CROSS-distribution malicious (JBB)     k=0: 0.98 [0.91,1.00]  k=3: 0.70 [0.43,0.90]  k=6: 0.51 [0.26,0.78]  k=9: 0.28 [0.08,0.54]\n","  benign vs cross-distribution, norm-matched       k=0: 1.00 [1.00,1.00]  k=3: 0.57 [0.30,0.84]  k=6: 0.33 [0.12,0.58]  k=9: 