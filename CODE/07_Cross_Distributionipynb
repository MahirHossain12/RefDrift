refdrop1\":\n","                apply_delta(round_start, st); p = probe_proj(base); restore_ref(); scores.append(p - p_ref)\n","            elif defense == \"normdrop1\":\n","                scores.append(-delta_norm(st, round_start))\n","        kept = list(range(len(states)))\n","        if defense in (\"refdrop1\", \"normdrop1\"): kept.remove(int(np.argmin(scores)))\n","        set_peft_model_state_dict(model, average_states([states[i] for i in kept])); traj.append(refusal_rate(model, eval_adv))\n","        log.append({\"round\": rnd, \"sampled\": sampled, \"malicious\": [c in mal for c in sampled], \"scores\": scores, \"kept\": [sampled[i] for i in kept]})\n","        print(f\"  round {rnd:2d} [{''.join('M' if c in mal else 'b' for c in sampled)}] kept={[sampled[i] for i in kept]} AdvBench-eval refusal={traj[-1]:.0%}\")\n","        torch.save({\"round\": rnd, \"traj\": traj, \"log\": log, \"jbb0\": jbb0, \"rng\": r.getstate(), \"state\": snapshot(model)}, cpath + \".tmp\"); os.replace(cpath + \".tmp\", cpath)\n","    rec = {\"defense\": defense, \"attack\": attack, \"frac\": frac, \"seed\": seed, \"malicious_ids\": sorted(mal), \"traj\": traj, \"jbb0\": jbb0, \"jbb_final\": refusal_rate(model, jbb_eval), \"log\": log}\n","    json.dump(rec, open(fpath, \"w\"), indent=2); os.remove(cpath); print(f\"  final: AdvBench-eval {traj[-1]:.0%}, JBB-eval {rec['jbb_final']:.0%}\"); return rec\n","\n","# --- E0 gate: the no-attacker control must reproduce the earlier runs exactly (same model, data, sampling, determinism) ---\n","ctrl = [run_x(\"fedavg\", \"none\", 0.0, s) for s in SEEDS]\n","old = [json.load(open(f\"{E2E_OLD}/fedavg_plain_frac0.0_seed{s}_final.json\"))[\"traj\"][-1] for s in SEEDS]\n","new = [c[\"traj\"][-1] for c in ctrl]\n","print(f\"\\nE0 replication gate: no-attacker final AdvBench-eval refusal now {[round(100 * v, 1) for v in new]} vs earlier {[round(100 * v, 1) for v in old]}\")\n","assert all(abs(a - b) <= 1 / 32 + 1e-9 for a, b in zip(new, old)), \"