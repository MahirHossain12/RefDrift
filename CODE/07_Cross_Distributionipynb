y close to an AdvBench prompt (Jaccard >= 0.6); kept 82\n","cross-distribution poison pool: 50 | cross-distribution eval prompts: 32\n","categories in the poison pool: {'Expert advice': np.int64(8), 'Harassment/Discrimination': np.int64(7), 'Physical harm': np.int64(6), 'Privacy': np.int64(6), 'Fraud/Deception': np.int64(6), 'Sexual/Adult content': np.int64(5), 'Disinformation': np.int64(5), 'Government decision-making': np.int64(3), 'Economic harm': np.int64(3), 'Malware/Hacking': np.int64(1)}\n","mean prompt length (words): AdvBench poison pool 12.2 | JBB poison pool 14.0\n","NOTE: this tests a shift in the harmful PROMPTS; JBB targets use the same affirmative-prefix style as AdvBench.\n","pristine probe projection (stored-scale) = 5.2622 (earlier experiments: 5.2622) | stored direction norm = 1.0000\n","setup verified: same model, probe set, direction, states and initialization as the earlier experiments\n"]}]},{"cell_type":"code","source":["print(\"CELL C3: detector under a cross-distribution attacker (0.5B; n=10 per group per state; standard AND reference scoring; saved per state, resumable)\")\n","N_WIN = 10\n","GROUPS = [\"benign\", \"mal_in\", \"mal_cross\", \"mal_cross_matched\"]\n","def make_examples(group, rr):\n","    if group == \"benign\":   return [build_example(p[\"instruction\"], p[\"output\"]) for p in rr.sample(alpaca_benign, 10)]\n","    if group == \"mal_in\":   return [build_example(p[\"goal\"], p[\"target\"]) for p in rr.sample(poison_pool_adv, 10)]\n","    return [build_example(p[\"Goal\"], p[\"Target\"]) for p in rr.sample(jbb_pool, 10)]       # mal_cross, mal_cross_matched\n","\n","# --- norm-matching factor for the cross-distribution attacker, measured on SEPARATE calibration clients at the initial state ---\n","kpath = f\"{XD}/kappa_cross.json\"\n","if os.path.exists(kpath):\n","    kappa = json.load(open(kpath))[\"kappa_cross\"]\n","else:\n","    S0, nb, nm = states_at[0], [], []\n","    rb, rm = random.Random(7001), random.Random(7002)\n","    for i in range(10):\n","        set_peft_model_state_dict(pm, S0); nb.append(delta_norm(local_train(pm, make_examples(\"benign\", rb), CFG[\"local_steps\"], CFG[\"lr\"]), S0))\n","        set_peft_model_state_dict(pm, S0); nm.append(delta_norm(local_train(pm, make_examples(\"mal_cross\", rm), CFG[\"local_steps\"], CFG[\"lr\"]), S0))\n","    kappa = float(np.mean(nb) / np.mean(nm))\n","    json.dump({\"kappa_cross\": kappa, \"benign_norms\": nb, \"mal_cross_norms\": nm}, open(kpath, \"w\"))\n","print(f\"norm-matching learning-rate factor for the cross-distribution attacker = {kappa:.3f} (0.5B in-distribution attacker used 0.78)\")\n","\n","wpath = f\"{XD}/window_cross.json\"\n","W = json.load(open(wpath)) if os.path.exists(wpath) else {}\n","for k in [0, 3, 6, 9]:\n","    if str(k) in W:\n","        print(f\"state k={k} already done\"); continue\n","    S = states_at[k]; set_peft_model_state_dict(pm, S); p0_state = probe_proj(pm)\n","    Wk = {g: {\"std\": [], \"ref\": [], \"norm\": []} for g in GROUPS}\n","    for gi, g in enumerate(GROUPS):\n","        rr = random.Random(8000 + 100 * gi + k); lr = CFG[\"lr\"] * (kappa if g == \"mal_cross_matched\" else 1.0)\n","        for i in range(N_WIN):\n","            set_peft_model_state_dict(pm, S)\n","            st = local_train(pm, make_examples(g, rr), CFG[\"local_steps\"], lr)\n","            p_std = probe_proj(pm) - p0_state                       # standard: effect on the drifted state model\n","            apply_delta(S, st); p_tr = probe_proj(base) - p_ref      # reference: the same weight delta on the pristine model\n","            restore_ref()\n","            if k == 0 and gi == 0 and i == 0:\n","                print(f\"  transplant check at k=0: standard {p_std:+.4f} vs reference {p_tr:+.4f}\")\n","                assert abs(p_std - p_tr) < 0.05, \"transplant does not reproduce the standard score at k=0 -- stop and paste this\"\n","            Wk[g][\"std\"].append(p_std); Wk[g][\"ref\"].append(p_tr); Wk[g][\"norm\"].append(delta_norm(st, S))\n","        print(f\"  k={k} {g:18s} done | mean std {np.mean(Wk[g]['std']):+.4f} | mean ref {np.mean(Wk[g]['ref']):+.4f} | mean norm {np.mean(Wk[g]['norm']):.4f}\")\n","    W[str(k)] = Wk; json.dump(W, open(wpath, \"w\")); print(f\"  saved state k={k}\")\n","print(\"detector-level run complete\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"aiSu2MBl4jcO","executionInfo":{"status":"ok","timestamp":1793969669931,"user_tz":-360,"elapsed":678390,"user":{"displayName":"Mahir","userId":"10169784916887599401"}},"outputId":"e46ac2f8-5e66-4bb6-b3da-51827aa990e8"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["CELL C3: detector under a cross-distribution attacker (0.5B; n=10 per group per state; standard AND reference scoring; saved per state, resumable)\n","norm-matching learning-rate factor for the cross-distribution attacker = 0.797 (0.5B in-distribution attacker used 0.78)\n","  transplant check at k=0: standard -0.1100 vs reference -0.1097\n","  k=0 benign             done | mean std -0.0702 | mean ref -0.0710 | mean norm 0.1689\n","  k=0 mal_in             done | mean std -0.2785 | mean ref -0.2806 | mean norm 0.2201\n","  k=0 mal_cross          done | mean std -0.2080 | mean ref -0.2107 | mean norm 0.2072\n","  k=0 mal_cross_matched  done | mean std -0.1678 | mean ref -0.1695 | mean norm 0.1683\n","  saved state k=0\n","  k=3 benign             done | mean std -0.1776 | mean ref -0.1305 | mean norm 0.2025\n","  k=3 mal_in             done | mean std -0.2896 | mean ref -0.2726 | mean norm 0.2340\n","  k=3 mal_cross          done | mean std -0.1762 | mean ref -0.1748 | mean norm 0.2209\n","  k=3 mal_cross_matched  done | mean std -0.1411 | mean ref -0.1362 | mean norm 0.1758\n","  saved state k=3\n","  k=6 benign             done | mean std -0.1152 | mean ref -0.0912 | mean norm 0.1946\n","  k=6 mal_in             done | mean std -0.0868 | mean ref -0.1500 | mean norm 0.2324\