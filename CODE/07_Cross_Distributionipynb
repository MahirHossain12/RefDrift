 (paired p=0.120)\n","  (report only) refdrop1 final refusal, cross-distribution minus in-distribution attacker (paired seeds): -12.5 (p=0.321)\n"]}]},{"cell_type":"code","source":["print(\"CELL C7: standalone figures 13-14 for the cross-distribution experiment (needs only Drive; no other cell)\")\n","import os, json\n","import numpy as np\n","import matplotlib as mpl\n","import matplotlib.pyplot as plt\n","try:\n","    from google.colab import drive\n","    if not os.path.exists(\"/content/drive/MyDrive\"): drive.mount(\"/content/drive\")\n","except ImportError:\n","    pass\n","R = \"/content/drive/MyDrive/fedllm-safety-defense/results\"; XD, OLD, FIG = f\"{R}/cross_distribution\", f\"{R}/part4c_diagnostic/end_to_end\", f\"{R}/figures\"; os.makedirs(FIG, exist_ok=True)\n","C = {\"blue\": \"#0072B2\", \"orange\": \"#E69F00\", \"green\": \"#009E73\", \"red\": \"#D55E00\", \"purple\": \"#CC79A7\", \"grey\": \"#7F7F7F\", \"black\": \"#000000\"}\n","mpl.rcParams.update({\"font.family\": \"serif\", \"font.serif\": [\"STIXGeneral\", \"DejaVu Serif\"], \"mathtext.fontset\": \"stix\", \"font.size\": 8, \"axes.labelsize\": 8, \"axes.titlesize\": 8,\n","    \"xtick.labelsize\": 7, \"ytick.labelsize\": 7, \"legend.fontsize\": 7, \"axes.linewidth\": 0.6, \"lines.linewidth\": 1.2, \"lines.markersize\": 3.5, \"axes.spines.top\": False, \"axes.spines.right\": False,\n","    \"axes.grid\": True, \"grid.alpha\": 0.25, \"grid.linewidth\": 0.4, \"figure.dpi\": 150, \"savefig.dpi\": 300, \"savefig.bbox\": \"tight\", \"savefig.pad_inches\": 0.03, \"pdf.fonttype\": 42, \"ps.fonttype\": 42})\n","COL2 = 7.0\n","def save(fig, name):\n","    for ext in (\"pdf\", \"png\"): fig.savefig(f\"{FIG}/{name}.{ext}\")\n","    plt.close(fig); print(f\"  saved {FIG}/{name}.pdf (+ .png)\")\n","def panel(ax, s): ax.text(-0.13, 1.04, s, transform=ax.transAxes, fontsize=9, fontweight=\"bold\", va=\"bottom\", ha=\"left\")\n","def auc_np(neg, pos):\n","    d = np.asarray(pos, float)[:, None] - np.asarray(neg, float)[None, :]\n","    return float((d > 0).mean() + 0.5 * (d == 0).mean())\n","def auc_ci(neg, pos, sign, n_boot=2000, seed=0):\n","    neg, pos = sign * np.asarray(neg, float), sign * np.asarray(pos, float); rng = np.random.default_rng(seed)\n","    b = [auc_np(rng.choice(neg, len(neg)), rng.choice(pos, len(pos))) for _ in range(n_boot)]\n","    return auc_np(neg, pos), float(np.percentile(b, 2.5)), float(np.percentile(b, 97.5))\n","def errbar(ax, x, a, **kw):\n","    a = np.asarray(a); ax.errorbar(x, a[:, 0], yerr=[a[:, 0] - a[:, 1], a[:, 2] - a[:, 0]], capsize=1.5, elinewidth=0.7, **kw)\n","\n","def fig13():\n","    W = json.load(open(f\"{XD}/window_cross.json\")); KS = sorted(int(k) for k in W)\n","    fig, axes = plt.subplots(1, 2, figsize=(COL2, 2.5), sharey=True)\n","    for ax, (key, title, lab) in zip(axes, [(\"std\", \"Standard scoring\", \"(a)\"), (\"ref\", \"Reference-model scoring\", \"(b)\")]):\n","        for j, (g, name, c, m) in enumerate([(\"mal_in\", \"in-distribution (AdvBench)\", C[\"blue\"], \"o\"), (\"mal_cross\", \"cross-distribution (JBB)\", C[\"green\"], \"s\"),\n","                                             (\"mal_cross_matched\", \"cross-distribution, norm-matched\", C[\"orange\"], \"^\")]):\n","            errbar(ax, np.array(KS) + (j - 1) * 0.15, [auc_ci(W[str(k)][\"benign\"][key], W[str(k)][g][key], -1) for k in KS], color=c, marker=m, label=name)\n","        ax.axhline(0.5, color=C[\"grey\"], ls=\":\", lw=0.7); ax.set_title(title); ax.set_xlabel(\"Benign-only rounds before scoring ($k$)\"); ax.set_xticks(KS); ax.set_ylim(0, 1.05); panel(ax, lab)\n","    axes[0].set_ylabel(\"AUC (benign vs. malicious)\"); axes[0].legend(frameon=False, loc=\"lower left\")\n","    fig.tight_layout(); save(fig, \"fig13_cross_distribution_detector\")\n","\n","def fig14():\n","    SEEDS = [42, 43, 44]\n","    def vals(path_fn): return [100 * json.load(open(path_fn(s)))[\"traj\"][-1] for s in SEEDS]\n","    arms = [(\"fedavg\", \"Undefended\", C[\"grey\"]), (\"refdrop1\", \"Reference\\nscoring\", C[\"blue\"]), (\"normdrop1\", \"Weight-norm\\ndrop\", C[\"orange\"])]\n","    fig, ax = plt.subplots(figsize=(COL2 * 0.62, 2.6))\n","    for i, (d, name, c) in enumerate(arms):\n","        for j, (lab, fn, al) in enumerate([(\"in-distribution attacker\", lambda s, d=d: f\"{OLD}/{d}_plain_frac0.4_seed{s}_final.json\", 0.35),\n","                                           (\"cross-distribution attacker\", lambda s, d=d: f\"{XD}/e2e/{d}_cross_frac0.4_seed{s}_final.json\", 0.8)]):\n","            v = vals(fn); x = i + (j - 0.5) * 0.38\n","            ax.bar(x, np.mean(v), width=0.34, color=c, alpha=al, lw=0, hatch=\"\" if j == 0 else \"//\", edgecolor=\"white\")\n","            ax.scatter(x + np.linspace(-0.07, 0.07, len(v)), v, color=c, s=11, zorder=3, edgecolor=\"white\", linewidth=0.4)\n","    ctrl = np.mean([100 * json.load(open(f\"{XD}/e2e/fedavg_none_frac0.0_seed{s}_final.json\"))[\"traj\"][-1] for s in SEEDS])\n","    ax.axhline(ctrl, color=C[\"black\"], ls=\"--\", lw=0.8); ax.text(2.45, ctrl + 1.5, \"no attacker\", fontsize=6, ha=\"right\")\n","    ax.set_xticks(range(3)); ax.set_xticklabels([a[1] for a in arms], fontsize=6.5); ax.grid(axis=\"x\", visible=False); ax.set_ylim(0, 100)\n","    ax.set_ylabel(\"Final refusal, AdvBench-eval (%)\")\n","    from matplotlib.patches import Patch\n","    ax.legend(handles=[Patch(fc=C[\"grey\"], alpha=0.35, label=\"in-distribution attacker\"), Patch(fc=C[\"grey\"], alpha=0.8, hatch=\"//\", ec=\"white\", label=\"cross-distribution attacker\")], frameon=False, loc=\"upper left\")\n","    fig.tight_layout(); save(fig, \"fig14_cross_distribution_end_to_end\")\n","\n","for name, fn in [(\"Figure 13\", fig13), (\"Figure 14\", fig14)]:\n","    print(f\"{name}:\")\n","    try: fn()\n","    except Exception as e: print(f\"  !! {name} failed: {repr(e)[:300]}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"qCaFjPlFTmEo","executionInfo":{"status":"ok","timestamp":17939